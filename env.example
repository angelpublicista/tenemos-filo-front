# Copia este archivo como .env.local y llena los valores reales.
# Hay una referencia completa de las dos aplicaciones en el repo del API:
# tenemosfilo-api/env.example.txt

# ==========================================
# Conexion con el API (tenemosfilo-api)
# ==========================================

# La usa el servidor de Next (proxy y rutas de auth). No se expone al
# navegador, asi que puede ser una direccion interna.
API_URL=http://localhost:4000

# La misma direccion, pero para el navegador: tiene que ser accesible desde
# fuera. Todo lo que lleve NEXT_PUBLIC_ viaja al cliente y es publico.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# NextAuth
# ==========================================

# Secret HS256 que firma el JWT de sesion.
# IMPORTANTE: debe ser el MISMO valor que NEXTAUTH_SECRET del API. Si no
# coinciden, el login parece funcionar pero cada llamada al API da 401.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-largo

# URL canonica del front (necesaria si el deploy esta detras de un proxy)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (las mismas credenciales que registra el API)
# Consola: https://console.cloud.google.com/apis/credentials
# URI de retorno autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ==========================================
# Correo transaccional (ZeptoMail, de Zoho)
# ==========================================
# El grueso del correo lo manda el API. Aqui solo queda lo que se compone en
# el front: las cotizaciones del CRM.
#
# Son las MISMAS variables que usa el API a proposito: si las dos aplicaciones
# se despliegan juntas, el correo se configura una sola vez.
#
# El token sale de: ZeptoMail > Mail Agents > [tu agente] > Setup > Send Mail
# Token. Es el token del agente, NO la API key de la cuenta Zoho. Da igual si
# lo pegas con o sin el prefijo "Zoho-enczapikey".
ZEPTOMAIL_TOKEN=""
# Remitente verificado dentro del dominio del agente.
ZEPTOMAIL_FROM_EMAIL="noreply@tenemosfilo.com"
ZEPTOMAIL_FROM_NAME="Tenemos Filo"
# Solo si la cuenta esta en un centro de datos regional (.eu, .in)
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# ==========================================
# reCAPTCHA
# ==========================================
# OJO: hoy solo se pinta el widget. Nada valida el token contra Google en el
# servidor, asi que no esta filtrando nada todavia.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_site_key_de_recaptcha

# ==========================================
# Sanity (heredado)
# ==========================================
# Ya no guarda los datos del proyecto, pero las imagenes subidas antes de la
# migracion siguen ahi y src/lib/images.ts las resuelve. Si se quitan, esas
# imagenes antiguas dejan de verse; las nuevas van a S3 y no se afectan.
NEXT_PUBLIC_SANITY_PROJECT_ID=tu_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# ==========================================
# Firebase (heredado)
# ==========================================
# De todo Firebase solo sigue vivo el flujo de verificacion de correo
# (/verify-email). La autenticacion paso a NextAuth y las notificaciones al API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================
# Opcionales, sin configurar hoy
# ==========================================

# Generador de descripciones con IA (/api/ai/generate-description).
# Sin la clave, esa funcion no esta disponible; el resto del panel va igual.
OPENAI_API_KEY=
OPENAI_MODEL=

# Integraciones de calendario. Las rutas OAuth existen pero la integracion no
# esta terminada.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
